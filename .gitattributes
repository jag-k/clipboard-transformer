# Keep repository text files normalized to LF on every platform.
* text=auto eol=lf

# Binary assets must not be line-ending normalized.
*.car binary
*.icns binary
*.ico binary
*.png binary
# Raw RGBA tray icon pixels generated by `just gen-icons`. Never rely on the
# `text=auto` heuristic here: appending or rewriting a byte changes the pixel
# buffer length and breaks the drift test.
*.rgba binary
*.wasm binary
