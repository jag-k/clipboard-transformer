<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Wasmtime JIT-compiles plugin modules into executable memory that is
	     not allocated with MAP_JIT, so the hardened runtime kills the process
	     with "Code Signature Invalid / Invalid Page" on the first plugin call
	     unless unsigned executable memory is allowed (verified empirically;
	     allow-jit alone is not sufficient). See .agents/runbooks/release/macos-signing.md. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
