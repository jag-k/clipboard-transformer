{
  "app-id": "dev.jagk.clipboard_transformer",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "clipboard-transformer-app",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=x11",
    "--socket=wayland",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "modules": [
    {
      "name": "clipboard-transformer",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/clipboard-transformer/cargo",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo build --offline --release --locked --no-default-features --bin clipboard-transformer",
        "cargo build --offline --release --locked --features desktop --bin clipboard-transformer-app",
        "install -Dm0755 target/release/clipboard-transformer ${FLATPAK_DEST}/bin/clipboard-transformer",
        "install -Dm0755 target/release/clipboard-transformer-app ${FLATPAK_DEST}/bin/clipboard-transformer-app",
        "install -Dm0644 package/flatpak/dev.jagk.clipboard_transformer.desktop ${FLATPAK_DEST}/share/applications/dev.jagk.clipboard_transformer.desktop",
        "install -Dm0644 package/flatpak/generated.metainfo.xml ${FLATPAK_DEST}/share/metainfo/dev.jagk.clipboard_transformer.metainfo.xml",
        "install -Dm0644 package/flatpak/dev.jagk.clipboard_transformer.service ${FLATPAK_DEST}/share/dbus-1/services/dev.jagk.clipboard_transformer.service",
        "install -Dm0644 assets/generated/linux/app-icon.png ${FLATPAK_DEST}/share/icons/hicolor/256x256/apps/dev.jagk.clipboard_transformer.png",
        "install -Dm0644 assets/tray.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/status/dev.jagk.clipboard_transformer-symbolic.svg",
        "install -Dm0644 LICENSE ${FLATPAK_DEST}/share/licenses/clipboard-transformer/LICENSE"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".flatpak-builder",
            ".git",
            "target"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
