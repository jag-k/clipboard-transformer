<component type="desktop-application">
  <id>dev.jagk.clipboard_transformer</id>
  <name>Clipboard Transformer</name>
  <summary>Transform clipboard content with configurable rules</summary>
  <developer id="dev.jagk">
    <name>jag-k</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <description>
    <p>
      Clipboard Transformer watches the desktop clipboard and applies ordered,
      configurable rules to text, URLs, and structured clipboard formats.
    </p>
    <p>
      It runs in the system tray, supports undo and actionable notifications,
      and includes a command-line interface for explicit transformations and
      diagnostics.
    </p>
  </description>
  <url type="homepage">https://github.com/jag-k/clipboard-transformer</url>
  <url type="bugtracker">https://github.com/jag-k/clipboard-transformer/issues</url>
  <url type="help">https://github.com/jag-k/clipboard-transformer/tree/main/docs</url>
  <url type="vcs-browser">https://github.com/jag-k/clipboard-transformer</url>
  <url type="contribute">https://github.com/jag-k/clipboard-transformer/blob/main/CONTRIBUTING.md</url>
  <launchable type="desktop-id">dev.jagk.clipboard_transformer.desktop</launchable>
  <branding>
    <color type="primary" scheme_preference="light">#ffa026</color>
    <color type="primary" scheme_preference="dark">#70221e</color>
  </branding>
  <categories>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>clipboard</keyword>
    <keyword>transform</keyword>
    <keyword>rules</keyword>
    <keyword>tray</keyword>
  </keywords>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <!-- The ID earlier releases were published under. -->
  <replaces>
    <id>dev.jag_k.clipboard_transformer</id>
  </replaces>
  <provides>
    <id>dev.jag_k.clipboard_transformer</id>
    <binary>clipboard-transformer</binary>
    <binary>clipboard-transformer-app</binary>
  </provides>
  <content_rating type="oars-1.1" />
